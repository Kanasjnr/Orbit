# Copy to orbit.env and fill in (orbit.env is gitignored).
#   cp paseo/orbit.env.example paseo/orbit.env

PARA_ID=2002
CHAIN_NAME=orbit-paseo
RELAY_CHAIN=paseo

PASEO_WS=wss://paseo-rpc.n.dwellir.com
# V2 relay spec for embedded collator relay (auto-downloaded if missing)
PASEO_RELAY_SPEC=
PASEO_RELAY_SPEC_URL=https://raw.githubusercontent.com/paseo-network/paseo-chain-specs/main/paseo.raw.json
PASEO_URI=

PASEO_OPERATOR=
PASEO_AURA=
PASEO_SESSION_URI=
# subkey inspect --scheme ed25519 "$PASEO_SESSION_URI" → public key hex
PASEO_SESSION_PUBKEY=

PASEO_BALANCE=1152921504606846976

COLLATOR_BASE=
COLLATOR_PORT=40333
COLLATOR_RPC=8845
RELAY_PORT=50343
RELAY_RPC=9988

HUB_WS=wss://asset-hub-paseo-rpc.n.dwellir.com
ORBIT_WS=ws://127.0.0.1:8845
ORBIT_ORACLE_URI=//Alice
