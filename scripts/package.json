{
  "name": "orbit-scripts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.4.0"
  },
  "description": "Asset Hub lab + hubFeed reporters",
  "scripts": {
    "postinstall": "papi",
    "papi:add": "papi add pah -n polkadot_asset_hub",
    "observe": "tsx hub-observe.ts",
    "observe:dry": "tsx hub-observe.ts --dry-run",
    "hub:setup": "tsx hub-setup.ts",
    "hub:lab": "npm run hub:setup && npm run hub:payout",
    "hub:payout": "tsx hub-payout.ts",
    "hub:loop": "tsx hub-loop.ts",
    "hub:loop:dry": "tsx hub-loop.ts --dry-run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@polkadot-api/descriptors": "file:.papi/descriptors",
    "@polkadot/api": "^16.4.6",
    "@polkadot/keyring": "^14.0.3",
    "polkadot-api": "^2.2.2",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@acala-network/chopsticks": "^1.5.1",
    "@types/node": "^22.13.10",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
